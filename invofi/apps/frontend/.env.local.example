# Copy to .env.local and fill in your values. See docs/08-environment-variables.md.

# ── Demo / mock mode (issue #107, optional) ────────────────────────────────
# Shows a "Try the demo" entry on the landing page hero. The demo experience
# reuses the offline mock layers so a reviewer can reach a portfolio with
# seeded data without an account or wallet. Set NEXT_PUBLIC_USE_MOCK=1 too for
# a fully offline demo deployment.
NEXT_PUBLIC_DEMO_MODE=

# ── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Stellar network ──────────────────────────────────────────────────────────
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_RPC_URL=https://soroban-testnet.stellar.org
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# ── XLM/USD reference rate (issue #182, optional) ─────────────────────────
# Manual override for the XLM→USD price used to render ≈ USD portfolio totals.
# When unset, the app fetches the rate from CoinGecko (cached 5 minutes) and
# falls back to $1 when offline. Set this to pin a fixed rate in any environment.
NEXT_PUBLIC_XLM_USD_PRICE=

# ── Protocol contracts (required) ────────────────────────────────────────────
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
NEXT_PUBLIC_FINANCING_CONTRACT_ID=
NEXT_PUBLIC_REPAYMENT_CONTRACT_ID=

# ── Invoice documents / IPFS (issue #222, optional) ────────────────────────
# SERVER-ONLY secrets: read by the app/api/documents/* route handlers on the
# Node.js runtime. NEVER prefix these with NEXT_PUBLIC_ (that would expose them
# to every browser). Required only to upload invoice proof documents.
PINATA_API_KEY=
PINATA_SECRET_API_KEY=

# Public IPFS gateway used to fetch document bytes for preview/verification
# (server-only; default https://ipfs.io/ipfs).
IPFS_GATEWAY_URL=

# ── Trustless Work escrow rail (Phase 2) ──────────────────────────────────────
# Milestone-gated disbursement on accept_offer: the financed amount is routed
# lender → escrow → (delivery milestone approved) → originator. The rail is
# OFF entirely unless the public flag below is set. Docs:
# docs/trustless-work-integration.md — request a key via the TW Backoffice.
#
# Client-side feature flag + environment (no secret in the browser):
NEXT_PUBLIC_TRUSTLESS_WORK_API_KEY=
NEXT_PUBLIC_TRUSTLESS_WORK_ENV=testnet
# InvoFi platform wallet: escrow admin / release signer / dispute resolver.
NEXT_PUBLIC_TRUSTLESS_WORK_PLATFORM_ADDRESS=
# InvoFi platform fee on disbursements, in percent (0.5 = 0.5%).
NEXT_PUBLIC_TRUSTLESS_WORK_PLATFORM_FEE=0.5

# SERVER-ONLY — the actual Trustless Work API key (format: id.secret).
# Never expose this to the browser; /api/escrow/* injects it server-side.
TW_ESCROW_API_KEY=
